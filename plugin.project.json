{
  "name": "GaxiaCompanion",
  "globIgnorePaths": [
    "**/*.spec.lua", "**/*.spec.luau",
    "**/*.test.lua", "**/*.test.luau",
    "**/jest.config.luau", "**/wally.toml"
  ],
  "tree": {
    "$path": "plugin/src",
    "Payload": {
      "$className": "Folder",
      "Gaxia_Packages": { "$path": "src/ReplicatedStorage/Gaxia_Packages" },
      "Gaxia_Packages_Server": { "$path": "src/ServerStorage/Gaxia_Packages_Server" },
      "Gaxia_ServerBootstrap": { "$path": "src/ServerScriptService/Gaxia_ServerBootstrap.server.lua" },
      "Gaxia_ClientBootstrap": { "$path": "src/StarterPlayer/StarterPlayerScripts/Gaxia_ClientBootstrap.client.lua" }
    }
  }
}
